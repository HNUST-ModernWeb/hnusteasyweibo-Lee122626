<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.weibo.mapper.PostFavoriteMapper">

    <select id="selectByPostIdAndUserId" resultType="com.example.weibo.entity.PostFavorite">
        select id, post_id, user_id, create_time
        from tb_post_favorite
        where post_id = #{postId} and user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into tb_post_favorite (post_id, user_id)
        values (#{postId}, #{userId})
    </insert>

    <delete id="deleteByPostIdAndUserId">
        delete from tb_post_favorite
        where post_id = #{postId} and user_id = #{userId}
    </delete>

</mapper>